# Porta HTTP do Supervisor (o Switchboard usa a 8443)
PORT=8444
# 0.0.0.0 = aceita acesso externo (usuários acessam http://<IP-publico>:PORT)
HOST=0.0.0.0

# Segredo usado para assinar as sessões (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-este-segredo

# Banco de CDR do Issabel — mesma VPS, então 127.0.0.1
CDR_DB_HOST=127.0.0.1
CDR_DB_PORT=3306
CDR_DB_USER=supervisor
CDR_DB_PASSWORD=senha-cdr
CDR_DB_NAME=asteriskcdrdb
CDR_DB_TABLE=cdr
# Alternativa ao TCP: conectar pelo socket local do MariaDB
# CDR_DB_SOCKET=/var/lib/mysql/mysql.sock

# Formato dos números de ramal (usado para separar ramais de troncos nos canais do CDR)
EXTENSION_PATTERN=^\d{2,6}$
# Nível de serviço padrão: % das chamadas atendidas em até N segundos
SLA_SECONDS=20

# Administrador criado no primeiro start (se não houver usuários)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 1 = CDR simulado (demonstração sem Issabel)
MOCK_CDR=0
